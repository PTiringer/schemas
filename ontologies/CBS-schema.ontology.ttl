                   rdfs:subClassOf :PublicationMetadataField ;
                   rdfs:label "document type field" ;
                   :semanticProperty dcterms:type ,
                                     schema:genre ;
                   :sourceYamlPath "publication.document_type" .


###  https://example.org/CBS_projects/EmbargoPeriod
