foaf:Person rdf:type owl:Class .


###  https://example.org/CBS_projects/AcademicTitle
:AcademicTitle rdf:type owl:Class ;
               rdfs:subClassOf :RonjaConcept ;
               rdfs:label "academic title" ;
               :semanticProperty schema:honorificPrefix .


###  https://example.org/CBS_projects/AccessCondition
:AccessCondition rdf:type owl:Class ;
                 rdfs:subClassOf odrl:Policy ;
                 rdfs:comment "Condition governing access to data, metadata, publications, or supplementary materials." ;
                 rdfs:label "access condition" ;
                 :semanticProperty dcterms:accessRights ;
                 :sourceYamlPath "publication.access_limitations" .


###  https://example.org/CBS_projects/AccessEnvironment
:AccessEnvironment rdf:type owl:Class ;
                   rdfs:subClassOf :RonjaConcept ;
                   rdfs:label "access environment" .


###  https://example.org/CBS_projects/AccessLimitation
:AccessLimitation rdf:type owl:Class ;
                  rdfs:subClassOf :AccessCondition ;
                  rdfs:label "access limitation" ;
                  :semanticProperty dcterms:accessRights ,
                                    schema:conditionsOfAccess .


###  https://example.org/CBS_projects/AccessLimitationsField
:AccessLimitationsField rdf:type owl:Class ;
                        rdfs:subClassOf :AccessMetadataField ;
                        rdfs:label "access limitations field" ;
                        :semanticProperty dcterms:accessRights ,
                                          schema:conditionsOfAccess ;
                        :sourceYamlPath "publication.access_limitations" .


###  https://example.org/CBS_projects/AccessMetadataField
:AccessMetadataField rdf:type owl:Class ;
                     rdfs:subClassOf :MetadataFieldConcept ;
                     rdfs:label "access metadata field" .


###  https://example.org/CBS_projects/AccessRequest
:AccessRequest rdf:type owl:Class ;
               rdfs:subClassOf schema:Action ;
               rdfs:comment "Request procedure for restricted, archived, or otherwise non-public data." ;
               rdfs:label "access request" .


###  https://example.org/CBS_projects/AcquisitionMetadata
:AcquisitionMetadata rdf:type owl:Class ;
                     rdfs:subClassOf :AutomaticallyGeneratedMetadata ;
                     rdfs:label "acquisition metadata" ;
                     skos:closeMatch prov:Generation .


###  https://example.org/CBS_projects/AcquisitionParameter
:AcquisitionParameter rdf:type owl:Class ;
                      rdfs:subClassOf :MetadataRecord ;
                      rdfs:label "acquisition parameter" .


###  https://example.org/CBS_projects/AgeAttribute
:AgeAttribute rdf:type owl:Class ;
              rdfs:subClassOf :DemographicAttribute ;
              rdfs:label "age attribute" ;
              :semanticProperty schema:birthDate .


###  https://example.org/CBS_projects/Archive
:Archive rdf:type owl:Class ;
         rdfs:subClassOf premis:Storage ,
                         :StorageSystem ;
         rdfs:label "archive" ;
         skos:closeMatch schema:ArchiveOrganization .


###  https://example.org/CBS_projects/ArchiveRetrievalRequest
:ArchiveRetrievalRequest rdf:type owl:Class ;
                         rdfs:subClassOf :AccessRequest ;
                         rdfs:label "archive retrieval request" .


###  https://example.org/CBS_projects/AttributesOfSpecimenField
:AttributesOfSpecimenField rdf:type owl:Class ;
                           rdfs:subClassOf :DescriptiveMetadataField ;
                           rdfs:label "attributes of specimen field" ;
                           :semanticProperty schema:variableMeasured ;
                           :sourceYamlPath "data.attributes_of_specimen" .


###  https://example.org/CBS_projects/Author
:Author rdf:type owl:Class ;
        rdfs:subClassOf :Scientist ,
                        schema:Person ;
        rdfs:label "author" ;
        :semanticProperty dcterms:creator ,
                          schema:author .


###  https://example.org/CBS_projects/AutomatedDocumentation
:AutomatedDocumentation rdf:type owl:Class ;
                        rdfs:subClassOf :AutomaticallyGeneratedMetadata ;
                        rdfs:comment "Documentation generated automatically by scanners, software tools, or provenance capture." ;
                        rdfs:label "automated documentation" .


###  https://example.org/CBS_projects/AutomaticallyGeneratedMetadata
:AutomaticallyGeneratedMetadata rdf:type owl:Class ;
                                rdfs:subClassOf :MetadataRecord ;
                                rdfs:comment "Metadata generated by instruments or software, such as MRI scanner acquisition parameters." ;
                                rdfs:label "automatically generated metadata" ;
                                skos:closeMatch prov:Entity ;
                                :sourceYamlPath "data.automatically_generated_metadata" .


###  https://example.org/CBS_projects/AutomaticallyGeneratedMetadataField
:AutomaticallyGeneratedMetadataField rdf:type owl:Class ;
                                     rdfs:subClassOf :ProvenanceMetadataField ;
                                     rdfs:label "automatically generated metadata field" ;
                                     :semanticProperty dcterms:conformsTo ,
                                                       prov:wasGeneratedBy ;
                                     :sourceYamlPath "data.automatically_generated_metadata" .


###  https://example.org/CBS_projects/BIDSMetadata
:BIDSMetadata rdf:type owl:Class ;
              rdfs:subClassOf :AcquisitionMetadata ;
              rdfs:comment "Metadata aligned with the Brain Imaging Data Structure, heavily used in processing and sharing but described by Enrico as a moving target." ;
              rdfs:label "BIDS metadata" .


###  https://example.org/CBS_projects/BehavioralMeasure
:BehavioralMeasure rdf:type owl:Class ;
                   rdfs:subClassOf :SpecimenAttribute ;
                   rdfs:label "behavioral measure" .


###  https://example.org/CBS_projects/BrainSpecimen
:BrainSpecimen rdf:type owl:Class ;
               rdfs:subClassOf :Specimen ;
               rdfs:comment "A brain or brain-related specimen, including living or post mortem cases where applicable." ;
               rdfs:label "brain specimen" ;
               skos:closeMatch <http://purl.obolibrary.org/obo/UBERON_0000955> .


###  https://example.org/CBS_projects/Citation
:Citation rdf:type owl:Class ;
          rdfs:subClassOf cito:Citation ,
                          :PublicationMetadata ;
          rdfs:label "citation" ;
          :semanticProperty schema:citation .


###  https://example.org/CBS_projects/CitationObligation
:CitationObligation rdf:type owl:Class ;
                    rdfs:subClassOf odrl:Duty ;
                    rdfs:comment "Obligation to cite datasets, publications, or persistent identifiers when reusing data." ;
                    rdfs:label "citation obligation" ;
                    :semanticProperty cito:cites .


###  https://example.org/CBS_projects/ClinicalObservation
:ClinicalObservation rdf:type owl:Class ;
                     rdfs:subClassOf :SpecimenAttribute ;
                     rdfs:label "clinical observation" ;
                     skos:closeMatch schema:Observation .


###  https://example.org/CBS_projects/ClosedAccess
:ClosedAccess rdf:type owl:Class ;
              rdfs:subClassOf :AccessCondition ;
              rdfs:label "closed access" .


###  https://example.org/CBS_projects/CommandLineInput
:CommandLineInput rdf:type owl:Class ;
                  rdfs:subClassOf prov:Entity ;
                  rdfs:comment "Command-line input used in a processing workflow." ;
                  rdfs:label "command-line input" .


###  https://example.org/CBS_projects/Consent
:Consent rdf:type owl:Class ;
         rdfs:subClassOf <http://purl.obolibrary.org/obo/DUO_0000001> ,
                         dpv:Consent ;
         rdfs:comment "Participant consent related to collection, processing, storage, reuse, or publication of personal or sensitive data." ;
         rdfs:label "consent" ;
         :sourceYamlPath "Project.consents" .


###  https://example.org/CBS_projects/ConsentRecord
:ConsentRecord rdf:type owl:Class ;
               rdfs:subClassOf :GovernanceRecord ;
               rdfs:comment "Metadata about consent. Signed consent forms are stored separately and are not accessible through NOMAD." ;
               rdfs:label "consent record" ;
               skos:closeMatch dpv:ConsentRecord .


###  https://example.org/CBS_projects/ConsentStatus
:ConsentStatus rdf:type owl:Class ;
               rdfs:subClassOf :Consent ;
               rdfs:comment "General consent framework for participant data use, separate from open access licenses applied to published outputs." ;
               rdfs:label "consent status" ;
               skos:closeMatch <http://purl.obolibrary.org/obo/DUO_0000002> ,
                               dpv:ConsentStatus ;
               :sourceYamlPath "subject.consent_status" .


###  https://example.org/CBS_projects/ConsentStatusField
:ConsentStatusField rdf:type owl:Class ;
                    rdfs:subClassOf :AccessMetadataField ;
                    rdfs:label "consent status field" ;
                    :semanticProperty dcterms:accessRights ;
                    :sourceYamlPath "subject.consent_status" .


###  https://example.org/CBS_projects/ContactField
:ContactField rdf:type owl:Class ;
              rdfs:subClassOf :RelationshipMetadataField ;
              rdfs:label "contact field" ;
              :semanticProperty vcard:hasEmail ,
                                schema:contactPoint ;
              :sourceYamlPath "researcher.contact" .


###  https://example.org/CBS_projects/ContactPoint
:ContactPoint rdf:type owl:Class ;
              rdfs:subClassOf vcard:Kind ,
                              schema:ContactPoint ;
              rdfs:comment "Contact details for responsible researchers or access requests." ;
              rdfs:label "contact point" ;
              :sourceYamlPath "researcher.contact" .


###  https://example.org/CBS_projects/ContractInterval
:ContractInterval rdf:type owl:Class ;
                  rdfs:subClassOf time:Interval ;
                  rdfs:comment "The duration or end date of a researcher's contract associated with the project." ;
                  rdfs:label "contract interval" ;
                  :sourceYamlPath "researcher.time_until_leaving" .


###  https://example.org/CBS_projects/CreativeCommonsLicense
:CreativeCommonsLicense rdf:type owl:Class ;
                        rdfs:subClassOf :OpenAccessLicense ;
                        rdfs:label "Creative Commons license" ;
                        skos:closeMatch cc:License .


###  https://example.org/CBS_projects/CustomSoftware
:CustomSoftware rdf:type owl:Class ;
                rdfs:subClassOf :SoftwareTool ;
                rdfs:comment "Software developed by researchers for experimental analysis or processing." ;
                rdfs:label "custom software" .


###  https://example.org/CBS_projects/DICOMMetadata
:DICOMMetadata rdf:type owl:Class ;
               rdfs:subClassOf :AcquisitionMetadata ;
               rdfs:comment "Scanner-originated medical imaging metadata where DICOM applies." ;
               rdfs:label "DICOM metadata" .


###  https://example.org/CBS_projects/DOIIdentifier
:DOIIdentifier rdf:type owl:Class ;
               rdfs:subClassOf datacite:ResourceIdentifier ,
                               :Identifier ;
               rdfs:comment "Persistent identifier assigned when a dataset is frozen and published." ;
               rdfs:label "DOI identifier" ;
               :semanticProperty bibo:doi .


###  https://example.org/CBS_projects/DataDownload
:DataDownload rdf:type owl:Class ;
              rdfs:subClassOf dcat:Distribution ,
                              schema:DataDownload ;
              rdfs:label "data download" .


###  https://example.org/CBS_projects/DataLifecycle
:DataLifecycle rdf:type owl:Class ;
               rdfs:subClassOf :RonjaConcept ;
               rdfs:comment "The full lifecycle from data acquisition and processing to storage, publication, and reuse." ;
               rdfs:label "data lifecycle" ;
               :sourceYamlPath "data_lifecycle" .


###  https://example.org/CBS_projects/DataLifecycleRecord
:DataLifecycleRecord rdf:type owl:Class ;
                     rdfs:subClassOf :MetadataRecord ;
                     rdfs:comment "Metadata record describing processing, storage, archiving, previews, and traceability for datasets." ;
                     rdfs:label "data lifecycle record" .


###  https://example.org/CBS_projects/DataLink
:DataLink rdf:type owl:Class ;
          rdfs:subClassOf dcat:Distribution ,
                          schema:DataDownload ;
          rdfs:comment "A reference or link to data in a database or specialized storage system." ;
          rdfs:label "data link" .


###  https://example.org/CBS_projects/DataProtectionOfficer
:DataProtectionOfficer rdf:type owl:Class ;
                       rdfs:subClassOf :Scientist ,
                                       dpv:DataProtectionOfficer ;
                       rdfs:comment "Responsible person for data protection and privacy-related matters at the institute. The answer identifies Joran Lepsien as the relevant contact." ;
                       rdfs:label "data protection officer" .


###  https://example.org/CBS_projects/DataSource
:DataSource rdf:type owl:Class ;
            rdfs:subClassOf prov:Entity ;
            rdfs:label "data source" ;
            :semanticProperty dcterms:source .


###  https://example.org/CBS_projects/DataTimestampField
:DataTimestampField rdf:type owl:Class ;
                    rdfs:subClassOf :ProvenanceMetadataField ;
                    rdfs:label "data timestamp field" ;
                    :semanticProperty dcterms:created ,
                                      prov:generatedAtTime ,
                                      schema:dateCreated ;
                    :sourceYamlPath "data.time_stamp" .


###  https://example.org/CBS_projects/DataTransformation
:DataTransformation rdf:type owl:Class ;
                    rdfs:subClassOf :ProcessingStep ;
                    rdfs:label "data transformation" ;
                    skos:closeMatch prov:Activity .


###  https://example.org/CBS_projects/DataUsePermission
:DataUsePermission rdf:type owl:Class ;
                   rdfs:subClassOf <http://purl.obolibrary.org/obo/DUO_0000001> ,
                                   odrl:Permission ;
                   rdfs:label "data use permission" ;
                   skos:closeMatch dpv:Consent .


###  https://example.org/CBS_projects/DatabaseSystem
:DatabaseSystem rdf:type owl:Class ;
                rdfs:subClassOf :StorageSystem ;
                rdfs:comment "An institute database system that may store participant information or actual research data externally to NOMAD." ;
                rdfs:label "database system" .


###  https://example.org/CBS_projects/Dataset
:Dataset rdf:type owl:Class ;
         rdfs:subClassOf <http://purl.obolibrary.org/obo/IAO_0000100> ,
                         dcat:Dataset ,
                         prov:Entity ,
                         schema:Dataset ;
         rdfs:comment "A dataset acquired, reused, processed, archived, frozen, published, or referenced in the project lifecycle." ;
         rdfs:label "dataset" ;
         :sourceYamlPath "data" .


###  https://example.org/CBS_projects/DefaultPreview
:DefaultPreview rdf:type owl:Class ;
                rdfs:subClassOf :MetadataRecord ,
                                schema:MediaObject ;
                rdfs:comment "Default visual representation of a dataset, such as thumbnail, figure, chart, image, or 3D volume preview." ;
                rdfs:label "default preview" ;
                :sourceYamlPath "data_lifecycle.default_preview" .


###  https://example.org/CBS_projects/DefaultPreviewField
:DefaultPreviewField rdf:type owl:Class ;
                     rdfs:subClassOf :RelationshipMetadataField ;
                     rdfs:label "default preview field" ;
                     :semanticProperty schema:image ,
                                       schema:thumbnail ;
                     :sourceYamlPath "data_lifecycle.default_preview" .


###  https://example.org/CBS_projects/DemographicAttribute
:DemographicAttribute rdf:type owl:Class ;
                      rdfs:subClassOf :SpecimenAttribute ;
                      rdfs:label "demographic attribute" .


