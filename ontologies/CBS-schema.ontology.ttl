                     rdfs:subClassOf :AccessMetadataField ;
                     rdfs:label "ethics approval field" ;
                     :sourceYamlPath "Project.ethics_approval" .


###  https://example.org/CBS_projects/EthicsCommittee
:EthicsCommittee rdf:type owl:Class ;
                 rdfs:subClassOf org:Organization ;
                 rdfs:label "ethics committee" ;
                 skos:closeMatch schema:Organization .


