@prefix : <https://example.org/CBS_projects/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix duo: <http://purl.obolibrary.org/obo/DUO_> .
@prefix iao: <http://purl.obolibrary.org/obo/IAO_> .
@prefix obi: <http://purl.obolibrary.org/obo/OBI_> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix cito: <http://purl.org/spar/cito/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix fabio: <http://purl.org/spar/fabio/> .
@prefix ronja: <https://example.org/ronja/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix premis: <http://www.loc.gov/premis/rdf/v3/> .
@prefix schema: <https://schema.org/> .
@prefix uberon: <http://purl.obolibrary.org/obo/UBERON_> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix codemeta: <https://codemeta.github.io/terms/> .
@prefix datacite: <http://purl.org/spar/datacite/> .
@prefix ncbitaxon: <http://purl.obolibrary.org/obo/NCBITaxon_> .
@base <https://example.org/CBS_projects/> .

<https://example.org/CBS_projects/> rdf:type owl:Ontology ;
                                     dcterms:description "Class-first draft ontology profile for NOMAD-based research data discovery, publication export, provenance documentation, and access governance at MPI CBS. This version incorporates Ronja and Enrico's domain clarifications from June 2026." ;
                                     dcterms:source "ronja.schema.archive.yaml" ;
                                     dcterms:title "Ronja lifecycle metadata application ontology draft" ;
                                     owl:versionInfo "2026-06-24 class-first mapping draft" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/source
dcterms:source rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#closeMatch
skos:closeMatch rdf:type owl:AnnotationProperty .


###  https://example.org/CBS_projects/reviewNote
:reviewNote rdf:type owl:AnnotationProperty ;
            rdfs:label "review note" .


###  https://example.org/CBS_projects/semanticProperty
:semanticProperty rdf:type owl:AnnotationProperty ;
                  rdfs:comment "External RDF property that a metadata field concept probably implements. This avoids asserting that a field concept class is equivalent to a property." ;
                  rdfs:label "semantic property" .


###  https://example.org/CBS_projects/sourceYamlPath
:sourceYamlPath rdf:type owl:AnnotationProperty ;
                rdfs:comment "Original YAML section or quantity path that motivated a local ontology concept." ;
                rdfs:label "source YAML path" .


#################################################################
#    Object Properties
#################################################################

###  http://purl.org/dc/terms/accessRights
dcterms:accessRights rdf:type owl:ObjectProperty .


###  http://purl.org/dc/terms/hasPart
dcterms:hasPart rdf:type owl:ObjectProperty .


###  http://purl.org/dc/terms/isPartOf
dcterms:isPartOf rdf:type owl:ObjectProperty .


###  http://purl.org/dc/terms/license
dcterms:license rdf:type owl:ObjectProperty .


###  http://purl.org/dc/terms/provenance
dcterms:provenance rdf:type owl:ObjectProperty .


###  http://purl.org/dc/terms/references
dcterms:references rdf:type owl:ObjectProperty .


###  http://purl.org/dc/terms/relation
dcterms:relation rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/adms#identifier
adms:identifier rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/dcat#distribution
dcat:distribution rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/org#role
org:role rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/prov#generated
prov:generated rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/prov#qualifiedAssociation
prov:qualifiedAssociation rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/prov#used
prov:used rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/prov#wasDerivedFrom
prov:wasDerivedFrom rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/prov#wasGeneratedBy
prov:wasGeneratedBy rdf:type owl:ObjectProperty .


###  https://example.org/CBS_projects/archivedIn
:archivedIn rdf:type owl:ObjectProperty ;
            rdfs:domain :Dataset ;
            rdfs:range :Archive ;
            rdfs:label "archived in" .


###  https://example.org/CBS_projects/derivedFrom
:derivedFrom rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf prov:wasDerivedFrom ;
             rdfs:domain :Dataset ;
             rdfs:range :Dataset ;
             rdfs:label "derived from" .


###  https://example.org/CBS_projects/describesProject
:describesProject rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf :hasProject ;
                  rdfs:domain :NOMADEntry ;
                  rdfs:range :Project ;
                  rdfs:label "describes project" .


###  https://example.org/CBS_projects/documentedByWikiPage
:documentedByWikiPage rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf dcterms:relation ;
                      rdfs:range :WikiPage ;
                      rdfs:label "documented by wiki page" ;
                      :sourceYamlPath "data_lifecycle.processing_on_wikipage" .


###  https://example.org/CBS_projects/freezesDataset
:freezesDataset rdf:type owl:ObjectProperty ;
                rdfs:domain :PublicationExport ;
                rdfs:range :FrozenDataset ;
                rdfs:label "freezes dataset" .


###  https://example.org/CBS_projects/generatedBy
:generatedBy rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf prov:wasGeneratedBy ;
             rdfs:domain :Dataset ;
             rdfs:range prov:Activity ;
             rdfs:label "generated by" .


###  https://example.org/CBS_projects/hasAccessCondition
:hasAccessCondition rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf dcterms:accessRights ;
                    rdfs:range :AccessCondition ;
                    rdfs:label "has access condition" .


###  https://example.org/CBS_projects/hasConsent
:hasConsent rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf dcterms:relation ;
            rdfs:range :Consent ;
            rdfs:label "has consent" .


###  https://example.org/CBS_projects/hasConsentStatus
:hasConsentStatus rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf :hasConsent ;
                  rdfs:range :ConsentStatus ;
                  rdfs:label "has consent status" .


###  https://example.org/CBS_projects/hasContactPoint
:hasContactPoint rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf schema:contactPoint ;
                 rdfs:range :ContactPoint ;
                 rdfs:label "has contact point" .


###  https://example.org/CBS_projects/hasContractInterval
:hasContractInterval rdf:type owl:ObjectProperty ;
                     rdfs:domain :ResearcherParticipation ;
                     rdfs:range :ContractInterval ;
                     rdfs:label "has contract interval" .


###  https://example.org/CBS_projects/hasDOI
:hasDOI rdf:type owl:ObjectProperty ;
        rdfs:subPropertyOf :hasIdentifier ;
        rdfs:range :DOIIdentifier ;
        rdfs:label "has DOI" .


###  https://example.org/CBS_projects/hasDataLink
:hasDataLink rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf dcat:distribution ;
             rdfs:domain :Dataset ;
             rdfs:range :DataLink ;
             rdfs:label "has data link" .


###  https://example.org/CBS_projects/hasDataset
:hasDataset rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf dcterms:hasPart ;
            rdfs:range :Dataset ;
            rdfs:label "has dataset" .


###  https://example.org/CBS_projects/hasEmbargoPeriod
:hasEmbargoPeriod rdf:type owl:ObjectProperty ;
                  rdfs:range :EmbargoPeriod ;
                  rdfs:label "has embargo period" .


###  https://example.org/CBS_projects/hasEthicsApproval
:hasEthicsApproval rdf:type owl:ObjectProperty ;
                   rdfs:domain :Project ;
                   rdfs:range :EthicsApproval ;
                   rdfs:label "has ethics approval" .


###  https://example.org/CBS_projects/hasFundingInformation
:hasFundingInformation rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf schema:funding ;
                       rdfs:domain :Publication ;
                       rdfs:range :FundingInformation ;
                       rdfs:label "has funding information" .


###  https://example.org/CBS_projects/hasIdentifier
:hasIdentifier rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf adms:identifier ;
               rdfs:range :Identifier ;
               rdfs:label "has identifier" .


###  https://example.org/CBS_projects/hasLicense
:hasLicense rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf dcterms:license ;
            rdfs:range :License ;
            rdfs:label "has license" .


###  https://example.org/CBS_projects/hasMetadataRecord
:hasMetadataRecord rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf dcterms:relation ;
                   rdfs:range :MetadataRecord ;
                   rdfs:label "has metadata record" .


###  https://example.org/CBS_projects/hasMethodDescription
:hasMethodDescription rdf:type owl:ObjectProperty ;
                      rdfs:domain :Publication ;
                      rdfs:range :MethodDescription ;
                      rdfs:label "has method description" .


###  https://example.org/CBS_projects/hasNOMADIdentifier
:hasNOMADIdentifier rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf :hasIdentifier ;
                    rdfs:domain :NOMADEntry ;
                    rdfs:range :NOMADIdentifier ;
                    rdfs:label "has NOMAD identifier" .


###  https://example.org/CBS_projects/hasORCID
:hasORCID rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf :hasIdentifier ;
          rdfs:domain :Scientist ;
          rdfs:range :ORCIDIdentifier ;
          rdfs:label "has ORCID" .


###  https://example.org/CBS_projects/hasPreview
:hasPreview rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf schema:thumbnail ;
            rdfs:domain :Dataset ;
            rdfs:range :DefaultPreview ;
            rdfs:label "has preview" .


###  https://example.org/CBS_projects/hasProcessingStep
:hasProcessingStep rdf:type owl:ObjectProperty ;
                   rdfs:domain :ProcessingWorkflow ;
                   rdfs:range :ProcessingStep ;
                   rdfs:label "has processing step" .


###  https://example.org/CBS_projects/hasProcessingWorkflow
:hasProcessingWorkflow rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf dcterms:provenance ;
                       rdfs:range :ProcessingWorkflow ;
                       rdfs:label "has processing workflow" .


###  https://example.org/CBS_projects/hasProject
:hasProject rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf dcterms:relation ;
            rdfs:range :Project ;
            rdfs:label "has project" .


###  https://example.org/CBS_projects/hasProjectIdentifier
:hasProjectIdentifier rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf :hasIdentifier ;
                      rdfs:domain :Project ;
                      rdfs:range :ProjectIdentifier ;
                      rdfs:label "has project identifier" .


###  https://example.org/CBS_projects/hasProjectProposal
:hasProjectProposal rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf dcterms:hasPart ;
                    rdfs:domain :Project ;
                    rdfs:range :ProjectProposal ;
                    rdfs:label "has project proposal" .


###  https://example.org/CBS_projects/hasProjectRole
:hasProjectRole rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf org:role ;
                rdfs:range :ProjectRole ;
                rdfs:label "has project role" .


###  https://example.org/CBS_projects/hasProvenanceRecord
:hasProvenanceRecord rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf dcterms:provenance ;
                     rdfs:range :ProvenanceRecord ;
                     rdfs:label "has provenance record" .


###  https://example.org/CBS_projects/hasPublication
:hasPublication rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf dcterms:relation ;
                rdfs:domain :Project ;
                rdfs:range :Publication ;
                rdfs:label "has publication" .


###  https://example.org/CBS_projects/hasPublicationMetadata
:hasPublicationMetadata rdf:type owl:ObjectProperty ;
                        rdfs:domain :Publication ;
                        rdfs:range :PublicationMetadata ;
                        rdfs:label "has publication metadata" .


###  https://example.org/CBS_projects/hasRequiredAttribute
:hasRequiredAttribute rdf:type owl:ObjectProperty ;
                      rdfs:domain :Project ;
                      rdfs:range :RequiredAttributeSet ;
                      rdfs:label "has required attribute" ;
                      :sourceYamlPath "Project.required_attributes" .


###  https://example.org/CBS_projects/hasResearcherParticipation
:hasResearcherParticipation rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf prov:qualifiedAssociation ;
                            rdfs:domain :Project ;
                            rdfs:range :ResearcherParticipation ;
                            rdfs:label "has researcher participation" .


###  https://example.org/CBS_projects/hasScientist
:hasScientist rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf schema:contributor ;
              rdfs:range :Scientist ;
              rdfs:label "has scientist" .


###  https://example.org/CBS_projects/hasSpecimen
:hasSpecimen rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :hasSubject ;
             rdfs:range :Specimen ;
             rdfs:label "has specimen" .


###  https://example.org/CBS_projects/hasSpecimenAttribute
:hasSpecimenAttribute rdf:type owl:ObjectProperty ;
                      rdfs:domain :Subject ;
                      rdfs:range :SpecimenAttribute ;
                      rdfs:label "has specimen attribute" ;
                      :sourceYamlPath "data.attributes_of_specimen" .


###  https://example.org/CBS_projects/hasStorageSystem
:hasStorageSystem rdf:type owl:ObjectProperty ;
                  rdfs:range :StorageSystem ;
                  rdfs:label "has storage system" .


###  https://example.org/CBS_projects/hasSubject
:hasSubject rdf:type owl:ObjectProperty ;
            rdfs:domain :Dataset ;
            rdfs:range :Subject ;
            rdfs:label "has subject" .


###  https://example.org/CBS_projects/producesDerivedDataset
:producesDerivedDataset rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf prov:generated ;
                        rdfs:domain :ProcessingWorkflow ;
                        rdfs:range :DerivedDataset ;
                        rdfs:label "produces derived dataset" .


###  https://example.org/CBS_projects/publishesDataset
:publishesDataset rdf:type owl:ObjectProperty ;
                  rdfs:domain :PublicationExport ;
                  rdfs:range :PublishedDataset ;
                  rdfs:label "publishes dataset" .


###  https://example.org/CBS_projects/referencesDataset
:referencesDataset rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf dcterms:references ;
                   rdfs:domain :Publication ;
                   rdfs:range :Dataset ;
                   rdfs:label "references dataset" ;
                   :sourceYamlPath "publication.references_to_data" .


###  https://example.org/CBS_projects/referencesProject
:referencesProject rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf dcterms:isPartOf ;
                   rdfs:domain :Dataset ;
                   rdfs:range :Project ;
                   rdfs:label "references project" ;
                   :sourceYamlPath "data.referencing_the_project" .


###  https://example.org/CBS_projects/storedIn
:storedIn rdf:type owl:ObjectProperty ;
          rdfs:domain :Dataset ;
          rdfs:range :StorageSystem ;
          rdfs:label "stored in" .


###  https://example.org/CBS_projects/usesCommandLineInput
:usesCommandLineInput rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf prov:used ;
                      rdfs:domain :ProcessingWorkflow ;
                      rdfs:range :CommandLineInput ;
                      rdfs:label "uses command-line input" .


###  https://example.org/CBS_projects/usesScript
:usesScript rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf prov:used ;
            rdfs:domain :ProcessingWorkflow ;
            rdfs:range :Script ;
            rdfs:label "uses script" .


###  https://example.org/CBS_projects/usesSoftwareTool
:usesSoftwareTool rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf prov:used ;
                  rdfs:domain :ProcessingWorkflow ;
                  rdfs:range :SoftwareTool ;
                  rdfs:label "uses software tool" .


###  https://example.org/CBS_projects/usesSourceDataset
:usesSourceDataset rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf prov:used ;
                   rdfs:domain :ProcessingWorkflow ;
                   rdfs:range :SourceDataset ;
                   rdfs:label "uses source dataset" .


###  https://schema.org/contactPoint
schema:contactPoint rdf:type owl:ObjectProperty .


###  https://schema.org/contributor
schema:contributor rdf:type owl:ObjectProperty .


###  https://schema.org/funding
schema:funding rdf:type owl:ObjectProperty .


###  https://schema.org/thumbnail
schema:thumbnail rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  https://example.org/CBS_projects/dateTimeValue
:dateTimeValue rdf:type owl:DatatypeProperty ;
               rdfs:range xsd:dateTime ;
               rdfs:label "date-time value" ;
               skos:closeMatch dcterms:created ,
                               prov:generatedAtTime ,
                               schema:dateCreated .


###  https://example.org/CBS_projects/descriptionValue
:descriptionValue rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf :literalValue ;
                  rdfs:range xsd:string ;
                  rdfs:label "description value" ;
                  skos:closeMatch dcterms:description .


###  https://example.org/CBS_projects/emailAddressValue
:emailAddressValue rdf:type owl:DatatypeProperty ;
                   rdfs:domain :ContactPoint ;
                   rdfs:range xsd:string ;
                   rdfs:label "email address value" ;
                   skos:closeMatch vcard:hasEmail ,
                                   schema:email .


###  https://example.org/CBS_projects/identifierValue
:identifierValue rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Identifier ;
                 rdfs:range xsd:string ;
                 rdfs:label "identifier value" .


###  https://example.org/CBS_projects/literalValue
:literalValue rdf:type owl:DatatypeProperty ;
              rdfs:range xsd:string ;
              rdfs:label "literal value" .


###  https://example.org/CBS_projects/nameValue
:nameValue rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf :literalValue ;
           rdfs:range xsd:string ;
           rdfs:label "name value" ;
           skos:closeMatch schema:name .


###  https://example.org/CBS_projects/titleValue
:titleValue rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf :literalValue ;
            rdfs:range xsd:string ;
            rdfs:label "title value" ;
            skos:closeMatch dcterms:title .


###  https://example.org/CBS_projects/versionValue
:versionValue rdf:type owl:DatatypeProperty ;
              rdfs:range xsd:string ;
              rdfs:label "version value" ;
              skos:closeMatch schema:softwareVersion .


