                         rdfs:subClassOf :RelationshipMetadataField ;
                         rdfs:label "referencing the project field" ;
                         :semanticProperty dcterms:isPartOf ,
                                           schema:isPartOf ;
                         :sourceYamlPath "data.referencing_the_project" .


###  https://example.org/CBS_projects/RelationshipMetadataField
:RelationshipMetadataField rdf:type owl:Class ;
                           rdfs:subClassOf :MetadataFieldConcept ;
                           rdfs:label "relationship metadata field" .


###  https://example.org/CBS_projects/Report
:Report rdf:type owl:Class ;
        rdfs:subClassOf fabio:ReportDocument ,
                        :Publication ;
        rdfs:label "report" .


###  https://example.org/CBS_projects/RequiredAttributeSet
:RequiredAttributeSet rdf:type owl:Class ;
                      rdfs:subClassOf :RonjaConcept ;
                      rdfs:comment "Participant or specimen characteristics that should be recorded for study interpretation and analysis." ;
                      rdfs:label "required attribute set" ;
                      :sourceYamlPath "Project.required_attributes" .


###  https://example.org/CBS_projects/RequiredAttributesField
:RequiredAttributesField rdf:type owl:Class ;
                         rdfs:subClassOf :DescriptiveMetadataField ;
                         rdfs:label "required attributes field" ;
                         :semanticProperty schema:variableMeasured ;
                         :sourceYamlPath "Project.required_attributes" .


###  https://example.org/CBS_projects/ResearchData
:ResearchData rdf:type owl:Class ;
              rdfs:subClassOf :Dataset ;
              rdfs:label "research data" .


###  https://example.org/CBS_projects/ResearchDataDiscoveryInterface
:ResearchDataDiscoveryInterface rdf:type owl:Class ;
                                rdfs:subClassOf :ResearchDataManagementPlatform ;
                                rdfs:comment "A tailored search interface for targeted research data discovery in NOMAD." ;
                                rdfs:label "research data discovery interface" ;
                                skos:closeMatch schema:SearchAction .


###  https://example.org/CBS_projects/ResearchDataManagementPlatform
:ResearchDataManagementPlatform rdf:type owl:Class ;
                                rdfs:subClassOf :RonjaConcept ,
                                                schema:SoftwareApplication ;
                                rdfs:comment "A central platform for managing, discovering, referencing, and publishing research data and metadata." ;
                                rdfs:label "research data management platform" ;
                                skos:closeMatch dcat:Catalog .


###  https://example.org/CBS_projects/Researcher
:Researcher rdf:type owl:Class ;
            rdfs:subClassOf :Scientist ;
            rdfs:label "researcher" ;
            skos:closeMatch prov:Agent ,
                            schema:Person .


###  https://example.org/CBS_projects/ResearcherField
:ResearcherField rdf:type owl:Class ;
                 rdfs:subClassOf :RelationshipMetadataField ;
                 rdfs:label "researcher field" ;
                 :semanticProperty dcterms:contributor ,
                                   prov:wasAssociatedWith ,
                                   schema:contributor ;
                 :sourceYamlPath "researcher.researcher" .


###  https://example.org/CBS_projects/ResearcherParticipation
:ResearcherParticipation rdf:type owl:Class ;
                         rdfs:subClassOf org:Membership ,
                                         prov:Association ;
                         rdfs:comment "The relation-like entity connecting a scientist, a project, and a role." ;
                         rdfs:label "researcher participation" .


###  https://example.org/CBS_projects/RonjaConcept
:RonjaConcept rdf:type owl:Class ;
              rdfs:comment "Top local class for concepts needed to describe projects, experimental data, publications, scientists, access conditions, and processing workflows." ;
              rdfs:label "Ronja concept" .


###  https://example.org/CBS_projects/Scanner
:Scanner rdf:type owl:Class ;
         rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0000968> ,
                         :Instrument ;
         rdfs:label "scanner" ;
         skos:closeMatch schema:MedicalDevice .


###  https://example.org/CBS_projects/ScientificCommunication
:ScientificCommunication rdf:type owl:Class ;
                         rdfs:subClassOf :Publication ;
                         rdfs:label "scientific communication" .


###  https://example.org/CBS_projects/Scientist
:Scientist rdf:type owl:Class ;
           rdfs:subClassOf prov:Agent ,
                           foaf:Person ,
                           schema:Person ;
           rdfs:comment "A researcher, contributor, study leader, or responsible person associated with a project." ;
           rdfs:label "scientist" ;
           skos:closeMatch org:Role ;
           :sourceYamlPath "researcher.researcher" .


###  https://example.org/CBS_projects/Script
:Script rdf:type owl:Class ;
        rdfs:subClassOf prov:Entity ,
                        schema:SoftwareSourceCode ;
        rdfs:label "script" ;
        :semanticProperty codemeta:codeRepository .


###  https://example.org/CBS_projects/SearchEngineIndexableRecord
:SearchEngineIndexableRecord rdf:type owl:Class ;
                             rdfs:subClassOf :MetadataRecord ,
                                             schema:WebPage ;
                             rdfs:comment "A NOMAD metadata record shaped so that common search engines can index and expose it." ;
                             rdfs:label "search engine indexable record" .


###  https://example.org/CBS_projects/SexGenderAttribute
:SexGenderAttribute rdf:type owl:Class ;
                    rdfs:subClassOf :DemographicAttribute ;
                    rdfs:label "sex or gender attribute" ;
                    :semanticProperty schema:gender .


###  https://example.org/CBS_projects/SoftwareTool
:SoftwareTool rdf:type owl:Class ;
              rdfs:subClassOf prov:SoftwareAgent ,
                              schema:SoftwareApplication ;
              rdfs:comment "Software used for processing data." ;
              rdfs:label "software tool" ;
              :semanticProperty codemeta:softwareRequirements .


###  https://example.org/CBS_projects/SoftwareVersion
:SoftwareVersion rdf:type owl:Class ;
                 rdfs:subClassOf :Identifier ;
                 rdfs:label "software version" ;
                 :semanticProperty schema:softwareVersion .


###  https://example.org/CBS_projects/SourceDataset
:SourceDataset rdf:type owl:Class ;
               rdfs:subClassOf :Dataset ;
               rdfs:label "source dataset" ;
               :semanticProperty dcterms:source ,
                                 prov:used .


###  https://example.org/CBS_projects/SpecializedStorageSystem
:SpecializedStorageSystem rdf:type owl:Class ;
                          rdfs:subClassOf :StorageSystem ;
                          rdfs:label "specialized storage system" .


###  https://example.org/CBS_projects/Specimen
:Specimen rdf:type owl:Class ;
          rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0100051> ,
                          :Subject ;
          rdfs:comment "A material subject or sample studied in an experiment." ;
          rdfs:label "specimen" ;
          skos:closeMatch schema:BioSample .


###  https://example.org/CBS_projects/SpecimenAttribute
:SpecimenAttribute rdf:type owl:Class ;
                   rdfs:subClassOf :RonjaConcept ;
                   rdfs:comment "A recorded characteristic of a participant, subject, specimen, or phantom." ;
                   rdfs:label "specimen attribute" ;
                   :semanticProperty schema:variableMeasured ;
                   :sourceYamlPath "data.attributes_of_specimen" .


###  https://example.org/CBS_projects/StorageAndArchiveField
:StorageAndArchiveField rdf:type owl:Class ;
                        rdfs:subClassOf :RelationshipMetadataField ;
                        rdfs:label "storage and archive field" ;
                        :semanticProperty dcterms:accessRights ,
                                          dcterms:provenance ;
                        :sourceYamlPath "data_lifecycle.storage_and_archive" .


###  https://example.org/CBS_projects/StorageSystem
:StorageSystem rdf:type owl:Class ;
               rdfs:subClassOf :RonjaConcept ;
               rdfs:label "storage system" ;
               skos:closeMatch dcat:DataService ;
               :sourceYamlPath "data_lifecycle.storage_and_archive" .


###  https://example.org/CBS_projects/StudyLeader
:StudyLeader rdf:type owl:Class ;
             rdfs:subClassOf org:Role ,
                             :Researcher ;
             rdfs:comment "The person leading the study, as Ronja expects for the researcher field." ;
             rdfs:label "study leader" .


###  https://example.org/CBS_projects/Subject
:Subject rdf:type owl:Class ;
         rdfs:subClassOf prov:Entity ,
                         :RonjaConcept ;
         rdfs:comment "A broad experimental subject. Enrico clarified that this can technically be anything, but usually falls into living specimen, post mortem specimen, or phantom." ;
         rdfs:label "subject" ;
         :sourceYamlPath "subject.subject" .


###  https://example.org/CBS_projects/SubjectField
:SubjectField rdf:type owl:Class ;
              rdfs:subClassOf :RelationshipMetadataField ;
              rdfs:comment "Should resolve to one or more subclasses of Subject: living specimen, post mortem specimen, or phantom specimen." ;
              rdfs:label "subject field" ;
              :sourceYamlPath "subject.subject" .


###  https://example.org/CBS_projects/SupplementaryMaterial
:SupplementaryMaterial rdf:type owl:Class ;
                       rdfs:subClassOf prov:Entity ,
                                       schema:CreativeWork ;
                       rdfs:label "supplementary material" .


###  https://example.org/CBS_projects/Thumbnail
:Thumbnail rdf:type owl:Class ;
           rdfs:subClassOf :DefaultPreview ;
           rdfs:label "thumbnail" ;
           :semanticProperty schema:thumbnail .


###  https://example.org/CBS_projects/TimeUntilLeavingField
:TimeUntilLeavingField rdf:type owl:Class ;
                       rdfs:subClassOf :DescriptiveMetadataField ;
                       rdfs:label "time until leaving field" ;
                       :semanticProperty time:hasEnd ,
                                         schema:endDate ;
                       :sourceYamlPath "researcher.time_until_leaving" .


###  https://example.org/CBS_projects/TissueSample
:TissueSample rdf:type owl:Class ;
              rdfs:subClassOf :Specimen ;
              rdfs:label "tissue sample" ;
              skos:closeMatch <http://purl.obolibrary.org/obo/OBI_0100051> ,
                              schema:BioSample .


###  https://example.org/CBS_projects/VolumePreview
:VolumePreview rdf:type owl:Class ;
               rdfs:subClassOf :DefaultPreview ;
               rdfs:label "3D volume preview" .


###  https://example.org/CBS_projects/WhitelistOnlyAccess
:WhitelistOnlyAccess rdf:type owl:Class ;
                     rdfs:subClassOf :AccessCondition ;
                     rdfs:comment "Explicitly approved access for named people or groups." ;
                     rdfs:label "whitelist-only access" .


###  https://example.org/CBS_projects/WikiPage
