###  https://example.org/CBS_projects/ManualDocumentation
:ManualDocumentation rdf:type owl:Class ;
                     rdfs:subClassOf :MetadataRecord ;
                     rdfs:comment "Human-created documentation used where automated capture is incomplete or unreliable." ;
                     rdfs:label "manual documentation" .


###  https://example.org/CBS_projects/MetadataFieldConcept
:MetadataFieldConcept rdf:type owl:Class ;
                      rdfs:subClassOf <http://purl.obolibrary.org/obo/IAO_0000030> ,
                                      :RonjaConcept ;
                      rdfs:comment "A class representing the meaning of a YAML form field, not the literal value entered in that field." ;
                      rdfs:label "metadata field concept" .


###  https://example.org/CBS_projects/MetadataOfDocumentField
:MetadataOfDocumentField rdf:type owl:Class ;
                         rdfs:subClassOf :PublicationMetadataField ;
                         rdfs:comment "The original YAML key contains a typo: metadata_of_dokument." ;
                         rdfs:label "metadata of document field" ;
                         :semanticProperty dcterms:bibliographicCitation ,
                                           schema:citation ;
                         :sourceYamlPath "publication.metadata_of_dokument" .


###  https://example.org/CBS_projects/MetadataRecord
:MetadataRecord rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.obolibrary.org/obo/IAO_0000030> ,
                                prov:Entity ;
                rdfs:comment "A record describing data, processing, access, publication, or project context." ;
                rdfs:label "metadata record" ;
                skos:closeMatch dcat:Resource ,
                                schema:CreativeWork .


###  https://example.org/CBS_projects/MethodDescription
:MethodDescription rdf:type owl:Class ;
                   rdfs:subClassOf :PublicationMetadata ;
                   rdfs:comment "Methods used in a publication, including software, programs, protocols, operating systems, and versions." ;
                   rdfs:label "method description" ;
                   :sourceYamlPath "publication.methods_applied" .


###  https://example.org/CBS_projects/MethodsAppliedField
:MethodsAppliedField rdf:type owl:Class ;
                     rdfs:subClassOf :ProvenanceMetadataField ;
                     rdfs:label "methods applied field" ;
                     :semanticProperty prov:used ,
                                       prov:wasGeneratedBy ;
                     :sourceYamlPath "publication.methods_applied" .


###  https://example.org/CBS_projects/NOMADEntry
:NOMADEntry rdf:type owl:Class ;
            rdfs:subClassOf dcat:Resource ,
                            prov:Entity ,
                            :MetadataRecord ;
            rdfs:comment "A NOMAD record that receives a NOMAD identifier and can describe a project, dataset, processing result, or publication-related resource." ;
            rdfs:label "NOMAD entry" ;
            skos:closeMatch schema:DataCatalog .


###  https://example.org/CBS_projects/NOMADIdentifier
:NOMADIdentifier rdf:type owl:Class ;
                 rdfs:subClassOf :Identifier ;
                 rdfs:comment "Identifier assigned to NOMAD entries while datasets are still open and modifiable." ;
                 rdfs:label "NOMAD identifier" .


###  https://example.org/CBS_projects/NOMADPlatform
:NOMADPlatform rdf:type owl:Class ;
               rdfs:subClassOf :ResearchDataManagementPlatform ;
               rdfs:comment "NOMAD as the institute's central metadata and research data management platform." ;
               rdfs:label "NOMAD platform" .


###  https://example.org/CBS_projects/NonCommercialLicense
:NonCommercialLicense rdf:type owl:Class ;
                      rdfs:subClassOf :CreativeCommonsLicense ;
                      rdfs:label "non-commercial license" ;
                      skos:closeMatch cc:NonCommercial .


###  https://example.org/CBS_projects/NotesWikiPagesField
:NotesWikiPagesField rdf:type owl:Class ;
                     rdfs:subClassOf :RelationshipMetadataField ;
                     rdfs:label "notes wiki pages field" ;
                     :semanticProperty dcterms:relation ;
                     :sourceYamlPath "Project.notes_wikipages" .


###  https://example.org/CBS_projects/OASISInternalArea
:OASISInternalArea rdf:type owl:Class ;
                   rdfs:subClassOf :AccessEnvironment ;
                   rdfs:comment "Institute-internal NOMAD area, contrasted with openly accessible NOMAD content." ;
                   rdfs:label "OASIS internal area" .


###  https://example.org/CBS_projects/ORCIDIdentifier
:ORCIDIdentifier rdf:type owl:Class ;
                 rdfs:subClassOf datacite:PersonalIdentifier ,
                                 :Identifier ;
                 rdfs:comment "Identifier for researchers and their contributions." ;
                 rdfs:label "ORCID identifier" ;
                 :semanticProperty schema:identifier .


###  https://example.org/CBS_projects/OfflineArchive
:OfflineArchive rdf:type owl:Class ;
                rdfs:subClassOf :Archive ;
                rdfs:comment "Secure offline archive environment used after online retention, for example for MRI data after four years." ;
                rdfs:label "offline archive" .


###  https://example.org/CBS_projects/OnlineStorage
:OnlineStorage rdf:type owl:Class ;
               rdfs:subClassOf :StorageSystem ;
               rdfs:label "online storage" .


###  https://example.org/CBS_projects/OpenAccess
:OpenAccess rdf:type owl:Class ;
            rdfs:subClassOf :PublicAccess ;
            rdfs:label "open access" ;
            :semanticProperty bibo:openAccess .


###  https://example.org/CBS_projects/OpenAccessLicense
:OpenAccessLicense rdf:type owl:Class ;
                   rdfs:subClassOf :License ;
                   rdfs:label "open access license" .


###  https://example.org/CBS_projects/OpenlyAccessibleArea
:OpenlyAccessibleArea rdf:type owl:Class ;
                      rdfs:subClassOf :AccessEnvironment ;
                      rdfs:comment "Open NOMAD area whose metadata records can support public discovery and indexing." ;
                      rdfs:label "openly accessible area" ;
                      skos:closeMatch dcat:Catalog .


###  https://example.org/CBS_projects/OperatingSystem
:OperatingSystem rdf:type owl:Class ;
                 rdfs:subClassOf schema:SoftwareApplication ;
                 rdfs:label "operating system" .


###  https://example.org/CBS_projects/OtherIdentifier
:OtherIdentifier rdf:type owl:Class ;
                 rdfs:subClassOf :Identifier ;
                 rdfs:comment "Flexible additional identifier beyond the primary key." ;
                 rdfs:label "other identifier" ;
                 :sourceYamlPath "data.other_keys" .


###  https://example.org/CBS_projects/OtherKeysField
:OtherKeysField rdf:type owl:Class ;
                rdfs:subClassOf :IdentifierMetadataField ;
                rdfs:label "other keys field" ;
                :semanticProperty dcterms:identifier ,
                                  adms:identifier ,
                                  schema:identifier ;
                :sourceYamlPath "data.other_keys" .


###  https://example.org/CBS_projects/Paper
:Paper rdf:type owl:Class ;
       rdfs:subClassOf fabio:ResearchPaper ,
                       :Publication ,
                       schema:ScholarlyArticle ;
       rdfs:label "paper" ;
       :sourceYamlPath "publication.document_type" .


###  https://example.org/CBS_projects/ParticipantInformation
:ParticipantInformation rdf:type owl:Class ;
                        rdfs:subClassOf :MetadataRecord ,
                                        dpv:PersonalData ;
                        rdfs:comment "Participant-related information stored separately in the institute's internal database due to data protection regulations." ;
                        rdfs:label "participant information" .


###  https://example.org/CBS_projects/PhantomSpecimen
:PhantomSpecimen rdf:type owl:Class ;
                 rdfs:subClassOf :Subject ;
                 rdfs:comment "A non-biological experimental object used as a phantom, generally a plastic sphere filled with gel and possibly internal structure." ;
                 rdfs:label "phantom specimen" ;
                 skos:closeMatch schema:Product .


###  https://example.org/CBS_projects/PhysiologicalAttribute
:PhysiologicalAttribute rdf:type owl:Class ;
                        rdfs:subClassOf :SpecimenAttribute ;
                        rdfs:label "physiological attribute" .


###  https://example.org/CBS_projects/PlasticSpherePhantom
:PlasticSpherePhantom rdf:type owl:Class ;
                      rdfs:subClassOf :GelPhantom ;
                      rdfs:label "plastic sphere phantom" .


###  https://example.org/CBS_projects/PostMortemSpecimen
:PostMortemSpecimen rdf:type owl:Class ;
                    rdfs:subClassOf :Specimen ;
                    rdfs:comment "A specimen acquired or studied after death, generally brain-related in Enrico's answer." ;
                    rdfs:label "post mortem specimen" .


###  https://example.org/CBS_projects/Poster
:Poster rdf:type owl:Class ;
        rdfs:subClassOf fabio:ConferencePoster ,
                        :ScientificCommunication ;
        rdfs:label "poster" .


###  https://example.org/CBS_projects/Presentation
:Presentation rdf:type owl:Class ;
              rdfs:subClassOf fabio:Presentation ,
                              :ScientificCommunication ;
              rdfs:label "presentation" .


###  https://example.org/CBS_projects/PrimaryData
:PrimaryData rdf:type owl:Class ;
             rdfs:subClassOf :RawData ;
             rdfs:comment "Primary data discovery is the first stated use case." ;
             rdfs:label "primary data" .


###  https://example.org/CBS_projects/ProcessingDatasetSet
:ProcessingDatasetSet rdf:type owl:Class ;
                      rdfs:subClassOf :RelationshipMetadataField ;
                      rdfs:comment "Collection of source, intermediate, and derived datasets associated with processing workflows." ;
                      rdfs:label "processing dataset set" ;
                      :sourceYamlPath "data_lifecycle.processing_datasets" .


###  https://example.org/CBS_projects/ProcessingDatasetsField
:ProcessingDatasetsField rdf:type owl:Class ;
                         rdfs:subClassOf :RelationshipMetadataField ;
                         rdfs:label "processing datasets field" ;
                         :semanticProperty dcterms:source ,
                                           prov:used ,
                                           prov:wasDerivedFrom ;
                         :sourceYamlPath "data_lifecycle.processing_datasets" .


###  https://example.org/CBS_projects/ProcessingInformationField
:ProcessingInformationField rdf:type owl:Class ;
                            rdfs:subClassOf :ProvenanceMetadataField ;
                            rdfs:label "processing information field" ;
                            :semanticProperty dcterms:provenance ,
                                              prov:wasGeneratedBy ;
                            :sourceYamlPath "data_lifecycle.processing_information" .


###  https://example.org/CBS_projects/ProcessingStep
:ProcessingStep rdf:type owl:Class ;
                rdfs:subClassOf prov:Activity ;
                rdfs:label "processing step" .


###  https://example.org/CBS_projects/ProcessingWikiPageField
:ProcessingWikiPageField rdf:type owl:Class ;
                         rdfs:subClassOf :RelationshipMetadataField ;
                         rdfs:label "processing wiki page field" ;
                         :semanticProperty dcterms:relation ,
                                           prov:wasInformedBy ;
                         :sourceYamlPath "data_lifecycle.processing_on_wikipage" .


###  https://example.org/CBS_projects/ProcessingWorkflow
:ProcessingWorkflow rdf:type owl:Class ;
                    rdfs:subClassOf prov:Activity ,
                                    schema:Action ;
                    rdfs:comment "A data generation, processing, transformation, or analysis workflow." ;
                    rdfs:label "processing workflow" ;
                    :sourceYamlPath "data_lifecycle.processing_information" .


###  https://example.org/CBS_projects/Project
:Project rdf:type owl:Class ;
         rdfs:subClassOf prov:Activity ,
                         :RonjaConcept ,
                         schema:ResearchProject ;
         rdfs:comment "A scientific project that produces, reuses, documents, processes, freezes, or publishes research data." ;
         rdfs:label "project" ;
         skos:closeMatch <http://purl.obolibrary.org/obo/OBI_0000066> ;
         :sourceYamlPath "Project" .


###  https://example.org/CBS_projects/ProjectConsentsField
:ProjectConsentsField rdf:type owl:Class ;
                      rdfs:subClassOf :AccessMetadataField ;
                      rdfs:label "project consents field" ;
                      :semanticProperty dcterms:accessRights ;
                      :sourceYamlPath "Project.consents" .


###  https://example.org/CBS_projects/ProjectDescriptionField
:ProjectDescriptionField rdf:type owl:Class ;
                         rdfs:subClassOf :DescriptiveMetadataField ;
                         rdfs:label "project description field" ;
                         :semanticProperty dcterms:description ,
                                           schema:description ;
                         :sourceYamlPath "Project.description" .


###  https://example.org/CBS_projects/ProjectIDField
:ProjectIDField rdf:type owl:Class ;
                rdfs:subClassOf :IdentifierMetadataField ;
                rdfs:label "project ID field" ;
                :semanticProperty dcterms:identifier ,
                                  schema:identifier ;
                :sourceYamlPath "Project.project_ID" .


###  https://example.org/CBS_projects/ProjectIdentifier
:ProjectIdentifier rdf:type owl:Class ;
                   rdfs:subClassOf :Identifier ;
                   rdfs:comment "Internal project ID connecting NOMAD entries with the institute's internal database." ;
                   rdfs:label "project identifier" ;
                   :sourceYamlPath "Project.project_ID" .


###  https://example.org/CBS_projects/ProjectProposal
:ProjectProposal rdf:type owl:Class ;
                 rdfs:subClassOf prov:Plan ,
                                 :Document ;
                 rdfs:comment "A project proposal describing research objectives, hypotheses, and planned methodology. Ronja's current working assumption is that this may remain text, pending Elke's input." ;
                 rdfs:label "project proposal" ;
                 skos:closeMatch schema:CreativeWork ;
                 :sourceYamlPath "Project.poject_proposal" .


###  https://example.org/CBS_projects/ProjectProposalField
:ProjectProposalField rdf:type owl:Class ;
                      rdfs:subClassOf :RelationshipMetadataField ;
                      rdfs:comment "The original YAML key contains a typo: poject_proposal." ;
                      rdfs:label "project proposal field" ;
                      :semanticProperty dcterms:hasPart ;
                      :sourceYamlPath "Project.poject_proposal" .


###  https://example.org/CBS_projects/ProjectRole
:ProjectRole rdf:type owl:Class ;
             rdfs:subClassOf org:Role ,
                             prov:Role ;
             rdfs:comment "A responsibility or role held by a scientist within a project." ;
             rdfs:label "project role" .


###  https://example.org/CBS_projects/ProjectTitleField
:ProjectTitleField rdf:type owl:Class ;
                   rdfs:subClassOf :DescriptiveMetadataField ;
                   rdfs:comment "Records the title of the project, not necessarily the title of an associated publication." ;
                   rdfs:label "project title field" ;
                   :semanticProperty dcterms:title ,
                                     schema:name ;
                   :sourceYamlPath "Project.title" .


###  https://example.org/CBS_projects/ProvenanceMetadataField
:ProvenanceMetadataField rdf:type owl:Class ;
                         rdfs:subClassOf :MetadataFieldConcept ;
                         rdfs:label "provenance metadata field" .


###  https://example.org/CBS_projects/ProvenanceRecord
:ProvenanceRecord rdf:type owl:Class ;
                  rdfs:subClassOf :MetadataRecord ;
                  rdfs:comment "A record that supports reconstruction of processing steps and transformations." ;
                  rdfs:label "provenance record" ;
                  skos:closeMatch prov:Bundle .


###  https://example.org/CBS_projects/PsychologicalQuestionnaireData
:PsychologicalQuestionnaireData rdf:type owl:Class ;
                                rdfs:subClassOf :ResearchData ;
                                rdfs:comment "A non-MRI data type explicitly mentioned as part of the institute's heterogeneous data landscape." ;
                                rdfs:label "psychological questionnaire data" .


###  https://example.org/CBS_projects/PuReIdentifier
:PuReIdentifier rdf:type owl:Class ;
                rdfs:subClassOf :Identifier ;
                rdfs:comment "Identifier for records in the institutional PuRe repository." ;
                rdfs:label "PuRe identifier" .


###  https://example.org/CBS_projects/PubMedIdentifier
:PubMedIdentifier rdf:type owl:Class ;
                  rdfs:subClassOf :Identifier ;
                  rdfs:label "PubMed identifier" ;
                  :semanticProperty bibo:pmid .


###  https://example.org/CBS_projects/PublicAccess
:PublicAccess rdf:type owl:Class ;
              rdfs:subClassOf :AccessCondition ;
              rdfs:label "public access" ;
              :semanticProperty schema:publicAccess .


###  https://example.org/CBS_projects/Publication
:Publication rdf:type owl:Class ;
             rdfs:subClassOf fabio:Expression ,
                             schema:CreativeWork ;
             rdfs:comment "Scientific publication or communication related to a project or dataset." ;
             rdfs:label "publication" ;
             :sourceYamlPath "publication" .


###  https://example.org/CBS_projects/PublicationExport
:PublicationExport rdf:type owl:Class ;
                   rdfs:subClassOf prov:Activity ;
                   rdfs:comment "Export of publication metadata or dataset metadata to support publication workflows." ;
                   rdfs:label "publication export" .


###  https://example.org/CBS_projects/PublicationMetadata
:PublicationMetadata rdf:type owl:Class ;
                     rdfs:subClassOf :MetadataRecord ;
                     rdfs:label "publication metadata" ;
                     :semanticProperty dcterms:bibliographicCitation ,
                                       schema:citation ;
                     :sourceYamlPath "publication.metadata_of_dokument" .


###  https://example.org/CBS_projects/PublicationMetadataField
:PublicationMetadataField rdf:type owl:Class ;
                          rdfs:subClassOf :MetadataFieldConcept ;
                          rdfs:label "publication metadata field" .


###  https://example.org/CBS_projects/PublishedDataset
:PublishedDataset rdf:type owl:Class ;
                  rdfs:subClassOf :FrozenDataset ;
                  rdfs:label "published dataset" ;
                  skos:closeMatch datacite:Resource ,
                                  schema:Dataset .


###  https://example.org/CBS_projects/Publisher
:Publisher rdf:type owl:Class ;
           rdfs:subClassOf prov:Agent ,
                           schema:Organization ;
           rdfs:label "publisher" .


###  https://example.org/CBS_projects/RORIdentifier
:RORIdentifier rdf:type owl:Class ;
               rdfs:subClassOf :Identifier ;
               rdfs:comment "Identifier for organizations such as institutes or funders." ;
               rdfs:label "ROR identifier" .


###  https://example.org/CBS_projects/RawData
:RawData rdf:type owl:Class ;
         rdfs:subClassOf :ResearchData ;
         rdfs:comment "Data originating directly from an acquisition source such as an MRI scanner." ;
         rdfs:label "raw data" ;
         skos:closeMatch prov:Entity .


