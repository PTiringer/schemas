:DoctorsOnlyAccess rdf:type owl:Class ;
                   rdfs:subClassOf :AccessCondition ;
                   rdfs:comment "Access limited to doctors, mentioned as a possible category to clarify with the institute data protection contact." ;
                   rdfs:label "doctors-only access" .


###  https://example.org/CBS_projects/Document
:Document rdf:type owl:Class ;
          rdfs:subClassOf <http://purl.obolibrary.org/obo/IAO_0000310> ,
